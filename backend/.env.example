# Postgres connection — either DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgres://textiles:textiles@localhost:5432/textiles

# Alternative (uncomment and remove DATABASE_URL if you prefer):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=textiles
# PGUSER=textiles
# PGPASSWORD=textiles

# Set to 'true' for managed Postgres providers that require TLS (e.g. Neon, RDS).
PGSSL=false

# Backend HTTP port.
PORT=3000

# Optional: max pool size.
PG_POOL_MAX=10

# Auth — REQUIRED. Use `openssl rand -hex 32` or any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h
